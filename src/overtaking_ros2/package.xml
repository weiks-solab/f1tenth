<?xml version="1.0"?>
<package format="3">
  <name>overtaking_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 integration for F1TENTH overtaking.</description>
  <maintainer email="maintainers@f1tenth.org">F1TENTH integration</maintainer>
  <license>Apache-2.0</license>
  <depend>overtaking_msgs</depend>
  <exec_depend>f1tenth_overtaking_core</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>car_control</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
